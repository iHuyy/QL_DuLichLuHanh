@model DuLich.Models.KhachHang
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Chỉnh sửa khách hàng</h4>
            </div>
            <div class="card-body">
                <form method="post" asp-action="EditUser">
                    <input type="hidden" asp-for="MaKhachHang" />
                    <div class="form-group">
                        <label>ORACLE_USERNAME</label>
                        <input class="form-control" asp-for="ORACLE_USERNAME" />
                    </div>
                    <div class="form-group">
                        <label>Họ tên</label>
                        <input class="form-control" asp-for="HoTen" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input class="form-control" asp-for="Email" />
                    </div>
                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input class="form-control" asp-for="SoDienThoai" />
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ</label>
                        <input class="form-control" asp-for="DiaChi" />
                    </div>
                    <div class="form-group">
                        <label>Vai trò</label>
                        <select class="form-control" asp-for="VaiTro">
                            <option value="KhachHang">Khách hàng</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <select class="form-control" asp-for="TrangThai">
                            <option value="HoatDong">Hoạt động</option>
                            <option value="BiKhoa">Bị khóa</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Lưu</button>
                        <a class="btn btn-light" href="/Admin/Users">Huỷ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
