@model IEnumerable<DuLich.Models.ChiNhanhViewModel>

@{
    ViewData["Title"] = "Quản lý Chi nhánh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
}
<div class="container-fluid">
    <div class="row page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Quản lý</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0)">Chi nhánh</a></li>
        </ol>
    </div>
    <!-- row -->

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Danh sách Chi nhánh</h4>
                    <a asp-controller="ChiNhanh" asp-action="Create" class="btn btn-primary">Thêm mới</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Tên Chi Nhánh</th>
                                    <th>Địa chỉ</th>
                                    <th>Số điện thoại</th>
                                    <th>Số nhân viên</th>
                                    <th>Số tour</th>
                                    <th>Doanh thu</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ChiNhanh.TenChiNhanh</td>
                                        <td>@item.ChiNhanh.DiaChi</td>
                                        <td>@item.ChiNhanh.SoDienThoai</td>
                                        <td>@item.SoNhanVien</td>
                                        <td>@item.SoTour</td>
                                        <td>@item.DoanhThu.ToString("N0") VNĐ</td>
                                        <td>
                                            <div class="d-flex">
                                                <a asp-controller="ChiNhanh" asp-action="Edit"
                                                    asp-route-id="@item.ChiNhanh.MaChiNhanh"
                                                    class="btn btn-primary shadow btn-xs sharp me-1">Sửa<i
                                                        class="fas fa-pencil-alt"></i></a>
                                                <a asp-controller="ChiNhanh" asp-action="Delete"
                                                    asp-route-id="@item.ChiNhanh.MaChiNhanh"
                                                    class="btn btn-danger shadow btn-xs sharp">Xóa<i
                                                        class="fa fa-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>