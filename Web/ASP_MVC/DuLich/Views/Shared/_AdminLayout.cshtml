<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Admin Dashboard</title>
    <!-- Favicon icon -->
    <link rel="icon" type="image/x-icon" href="~/images/logo.ico" asp-append-version="true" />
    <!-- Vectormap -->
    <link href="~/admin/vendor/jqvmap/css/jqvmap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/vendor/chartist/css/chartist.min.css">
    <!-- Summernote -->
    <link href="~/vendor/summernote/summernote.css" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="~/admin/css/style.css">
    @RenderSection("Styles", required: false)
</head>

<body>
    <div id="preloader">
        <div class="sk-three-bounce">
            <div class="sk-child sk-bounce1"></div>
            <div class="sk-child sk-bounce2"></div>
            <div class="sk-child sk-bounce3"></div>
        </div>
    </div>

    <div id="main-wrapper">
        <div class="nav-header">
            <a href="/Admin/Dashboard" class="brand-logo">
                <img class="logo-abbr" src="~/admin/images/logo-white.png" alt="Logo" loading="lazy">
                <img class="brand-title" src="~/admin/images/logo-text-white.png" alt="Du Lịch" loading="lazy">
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span>
                    <span class="line"></span>
                    <span class="line"></span>
                </div>
            </div>
        </div>

        <div class="header">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left"></div>
                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" role="button" data-toggle="dropdown">
                                    <i class="fa fa-user"></i>
                                    <span class="ml-2">@User.Identity?.Name</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <form asp-controller="Admin" asp-action="Logout" method="post" class="form-inline">
                                        <button type="submit" class="dropdown-item ai-icon">
                                            <i class="fa fa-sign-out-alt"></i>
                                            <span class="ml-2">Đăng xuất</span>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>

        <div class=" dlabnav">
            <div class="dlabnav-scroll">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    var action = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <ul class="metismenu" id="menu">
                    <li class="nav-label first">Main Menu</li>
                    <li class="@(controller == "Admin" && action == "Dashboard" ? "mm-active" : string.Empty)">
                        <a href="/Admin/Dashboard" aria-expanded="false" class="ai-icon">
                            <i class="fa fa-home"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li
                        class="@(controller == "Admin" && (action == "Users" || action == "CreateUser") ? "mm-active" : string.Empty)">
                        <a class="has-arrow ai-icon" href="javascript:void(0)" aria-expanded="false">
                            <i class="flaticon-028-user-1"></i>
                            <span class="nav-text">Quản lý người dùng</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a href="/admin/customer">Khách hàng</a></li>
                            <li><a href="/admin/staff">Nhân viên</a></li>
                        </ul>
                    </li>
                    <li class="@(controller == "ChiNhanh" ? "mm-active" : string.Empty)">
                        <a href="/admin/ChiNhanh" class="ai-icon" aria-expanded="false">
                            <i class="flaticon-041-graph"></i>
                            <span class="nav-text">Quản lý chi nhánh</span>
                        </a>
                    </li>
                    <li class="@(controller == "Admin" && action == "Tours" ? "mm-active" : string.Empty)">
                        <a href="/Admin/Tours" class="ai-icon" aria-expanded="false">
                            <i class="flaticon-041-graph"></i>
                            <span class="nav-text">Quản lý tour</span>
                        </a>
                    </li>
                    <li class="@(controller == "Admin" && action == "Bookings" ? "mm-active" : string.Empty)">
                        <a href="/Admin/Bookings" class="ai-icon" aria-expanded="false">
                            <i class="flaticon-041-graph"></i>
                            <span class="nav-text">Quản lý booking</span>
                        </a>
                    </li>
                    <li class="@(controller == "Admin" && action == "Audit" ? "mm-active" : string.Empty)">
                        <a href="/Admin/Audit" class="ai-icon" aria-expanded="false">
                            <i class="flaticon-041-graph"></i>
                            <span class="nav-text">Kiểm toán</span>
                        </a>
                    </li>
                    <li class="@(controller == "Admin" && action == "BackupRestore" ? "mm-active" : string.Empty)">
                        <a href="/Admin/BackupRestore" class="ai-icon" aria-expanded="false">
                            <i class="flaticon-041-graph"></i>
                            <span class="nav-text">Sao lưu &amp; phục hồi</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="content-body">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>

        <div class="footer">
            <div class="copyright">
                <p>Copyright Ac Designed &amp; Developed by Huy</p>
            </div>
        </div>
    </div>

    <script src="~/admin/vendor/global/global.min.js"></script>
    <script src="~/admin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/admin/js/custom.min.js"></script>
    <script src="~/admin/js/dlabnav-init.js"></script>
    <script src="~/admin/vendor/chartist/js/chartist.min.js"></script>
    <script src="~/admin/vendor/chart.js/Chart.bundle.min.js"></script>
    <script src="~/admin/vendor/jqvmap/js/jquery.vmap.min.js"></script>
    <script src="~/admin/vendor/jqvmap/js/jquery.vmap.world.js"></script>
    <script src="~/admin/js/dashboard.js"></script>
    <script src="~/admin/vendor/svganimation/vivus.min.js"></script>
    <script src="~/admin/vendor/svganimation/svg.animation.js"></script>
    <script src="~/admin/js/styleSwitcher.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
}