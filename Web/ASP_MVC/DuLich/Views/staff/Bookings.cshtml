@{
    ViewData["Title"] = "Quản lý booking";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>Quản lý booking</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="bookingsList" class="display table" style="min-width: 1100px">
                        <thead>
                            <tr>
                                <th>Tên tour</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Số người lớn</th>
                                <th>Số trẻ em</th>
                                <th>Ngày bắt đầu</th>
                                <th>Trạng thái</th>
                                <th>Tổng tiền</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal hiển thị hóa đơn -->
<div class="modal fade" id="invoiceModal" tabindex="-1" role="dialog" aria-labelledby="invoiceModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document" style="max-width: 90%;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="invoiceModalLabel">Hóa đơn</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="height: 80vh;">
                <iframe id="invoiceFrame" src="" style="border: none; width: 100%; height: 100%;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="sendEmailButton"><i class="fa fa-envelope"></i> Gửi hóa đơn cho khách hàng</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            loadBookings();

            // Click handler for the send email button inside the modal
            $('#sendEmailButton').on('click', function() {
                const modal = $('#invoiceModal');
                const hoaDonId = modal.data('hoaDonId');
                const customerName = modal.data('customerName');

                if (hoaDonId) {
                    sendInvoiceEmail(hoaDonId, customerName, this);
                } else {
                    toastr.error('Không tìm thấy mã hóa đơn để gửi.');
                }
            });
        });

        function badgeStatus(status) {
            if (!status) return '<span class="badge badge-warning">Chờ xác nhận</span>'; // Default for empty status to yellow for pending

            const lower = status.toLowerCase();

            if (lower.includes('hoan thanh')) {
                return '<span class="badge badge-success">Hoàn thành</span>'; // Green for completed
            } else if (lower.includes('xac nhan')) {
                // Distinguish "Chờ xác nhận" from "Đã xác nhận"
                if (lower.includes('cho')) {
                    return '<span class="badge badge-warning">Chờ xác nhận</span>'; // Yellow for pending
                } else { // Implies "Đã xác nhận"
                    return '<span class="badge badge-success">Đã xác nhận</span>'; // Green for confirmed
                }
            } else if (lower.includes('huy')) {
                return '<span class="badge badge-danger">Đã hủy</span>'; // Red for cancelled
            }

            return `<span class="badge badge-info">${status}</span>`; // Fallback for other statuses
        }

        function loadBookings() {
            $('#bookingsList').DataTable({
                ajax: '/api/admin/bookings',
                order: [[5, 'desc']],
                columns: [
                    { data: 'tenTour' },
                    { data: 'tenKhachHang' },
                    { data: 'ngayDat', render: d => d ? moment(d).format('DD/MM/YYYY') : '' },
                    { data: 'soNguoiLon' },
                    { data: 'soTreEm' },
                    { data: 'ngayBatDau', render: d => d ? moment(d).format('DD/MM/YYYY') : '' },
                    { data: 'trangThai', render: badgeStatus },
                    {
                        data: 'tongTien',
                        render: function (data) {
                            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {
                            const actions = [];
                            const hasInvoice = !!data.maHoaDon;
                            if (hasInvoice) {
                                // Pass customer name to showInvoice
                                actions.push(`<button class="btn btn-success btn-sm mr-1" onclick="showInvoice(${data.maHoaDon}, '${data.tenKhachHang}')">Xem hóa đơn</button>`);
                            }
                            const status = (data.trangThai || '').toLowerCase();
                            const isCancelled = status.includes('huy');
                            const isConfirmed = status.includes('xac nhan');
                            if (!isConfirmed && !isCancelled) {
                                actions.push(`<button class="btn btn-info btn-sm mr-1" onclick="confirmBooking(${data.maDatTour})">Xác nhận</button>`);
                            }
                            if (!isCancelled) {
                                actions.push(`<button class="btn btn-danger btn-sm" onclick="cancelBooking(${data.maDatTour})">Hủy</button>`);
                            }
                            return actions.join('');
                        }
                    }
                ]
            });
        }

        function confirmBooking(id) {
            $.post('/api/admin/bookings/confirm', { bookingId: id })
                .done(() => {
                    $('#bookingsList').DataTable().ajax.reload(null, false);
                    toastr.success('Đã xác nhận booking và cập nhật hóa đơn');
                })
                .fail(() => toastr.error('Không xác nhận được booking'));
        }

        function cancelBooking(id) {
            if (!confirm('Bạn có chắc chắn muốn hủy booking này?')) return;
            $.post('/api/admin/bookings/cancel', { bookingId: id, reason: 'Admin cancel' })
                .done(() => {
                    $('#bookingsList').DataTable().ajax.reload(null, false);
                    toastr.success('Đã hủy booking');
                })
                .fail(() => toastr.error('Không hủy được booking'));
        }

        function showInvoice(hoaDonId, customerName) {
            if (!hoaDonId) return;
            // Store data on the modal itself
            $('#invoiceModal').data('hoaDonId', hoaDonId);
            $('#invoiceModal').data('customerName', customerName);
            // Set iframe src and show modal
            $('#invoiceFrame').attr('src', `/Customer/PrintInvoice?hoaDonId=${hoaDonId}`);
            $('#invoiceModal').modal('show');
        }

        function sendInvoiceEmail(hoaDonId, customerName, button) {
            if (!confirm(`Bạn có chắc chắn muốn gửi hóa đơn cho khách hàng ${customerName}?`)) return;
            
            const $button = $(button);
            const originalHtml = $button.html();
            $button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang gửi...');

            $.post(`/api/hoadon/send-invoice/${hoaDonId}`)
                .done(function (response) {
                    toastr.success(response.message || 'Đã gửi hóa đơn thành công!');
                    $('#invoiceModal').modal('hide');
                })
                .fail(function (xhr) {
                    const error = xhr.responseJSON?.message || 'Không thể gửi hóa đơn. Vui lòng thử lại.';
                    toastr.error(error);
                })
                .always(function () {
                    $button.prop('disabled', false).html(originalHtml);
                });
        }
    </script>
}
