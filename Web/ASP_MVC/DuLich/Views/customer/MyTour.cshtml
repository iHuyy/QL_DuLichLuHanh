@using System.Linq
@model DuLich.Models.MyTourViewModel
@{
    ViewData["Title"] = "Tour của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Hero {
    <div class="container-fluid bg-primary py-5 mb-5 hero-header">
        <div class="container text-center py-5">
            <h1 class="display-5 text-white mb-3">Tour đã đặt</h1>
            <p class="text-white-50">Theo dõi trạng thái đặt chỗ, thanh toán và lịch trình của bạn.</p>
        </div>
    </div>
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-4 text-primary">Có thể bạn thích</h5>
                        @if (Model.PopularTours != null && Model.PopularTours.Any())
                        {
                            foreach (var tour in Model.PopularTours.Take(4))
                            {
                                var image = tour.Images.FirstOrDefault() ?? "/customer/travel-agency/img/destination-1.jpg";
                                <div class="d-flex mb-3 align-items-center">
                                    <img src="@image" alt="@tour.Title" class="rounded me-3"
                                         style="width: 80px; height: 60px; object-fit: cover;">
                                    <div>
                                        <h6 class="mb-1">
                                            <a asp-controller="Customer" asp-action="TourDetail" asp-route-id="@tour.MaTour" class="text-dark text-decoration-none">@tour.Title</a>
                                        </h6>
                                        <small class="text-muted"><i class="fa fa-map-marker-alt me-1 text-primary"></i>@tour.Destination</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Chưa có gợi ý nào.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                @if (Model.MyTours != null && Model.MyTours.Any())
                {
                    foreach (var tour in Model.MyTours)
                    {
                        var image = tour.Images.FirstOrDefault() ?? "/customer/travel-agency/img/carousel-1.jpg";
                        
                        // Xử lý hiển thị trạng thái
                        var statusInfo = tour.BookingStatus?.ToLower() switch
                        {
                            "b" => ("Chờ thanh toán", "secondary"),  // Chưa thanh toán
                            "p" => ("Đã thanh toán", "warning"),     // Đã thanh toán, chờ duyệt/hóa đơn
                            "y" => ("Đã xác nhận", "success"),       // Đã xong xuôi
                            "f" => ("Hoàn thành", "info"),           // Đã đi về
                            "c" => ("Đã hủy", "danger"),             // Đã hủy
                            _ => ("Đang xử lý", "light")
                        };

                        <div class="card border-0 shadow-sm mb-4">
                            <div class="row g-0">
                                <div class="col-md-4">
                                    <img src="@image" class="img-fluid rounded-start h-100" style="object-fit: cover; min-height: 200px;" alt="@tour.Title">
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-@statusInfo.Item2 px-3 py-2 rounded-pill">@statusInfo.Item1</span>
                                            <span class="text-muted small"><i class="fa fa-calendar-alt me-1"></i>@tour.Time</span>
                                        </div>

                                        <h5 class="card-title mb-1">@tour.Title</h5>
                                        <p class="text-muted mb-2 small"><i class="fa fa-map-marker-alt text-primary me-1"></i>@tour.Destination</p>
                                        
                                        <div class="mb-3">
                                            <span class="fw-bold text-primary fs-5">@tour.TotalPrice.ToString("N0") VNĐ</span>
                                            <small class="text-muted ms-2">(@(tour.NumAdults + tour.NumChildren) khách)</small>
                                        </div>

                                        <div class="mt-auto d-flex gap-2">
                                            <a asp-controller="Customer" asp-action="TourDetail" asp-route-id="@tour.TourId"
                                               class="btn btn-outline-primary btn-sm rounded-pill flex-fill">
                                               Xem lại Tour
                                            </a>
                                            <a asp-controller="Customer" asp-action="TourBooked"
                                               asp-route-bookingId="@tour.BookingId"
                                               class="btn btn-primary btn-sm rounded-pill flex-fill">
                                                @(tour.BookingStatus == "b" ? "Thanh toán ngay" : "Chi tiết đơn")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-plane-departure fa-4x text-muted mb-3"></i>
                        <h4>Bạn chưa đặt tour nào</h4>
                        <p class="text-muted">Hãy khám phá các điểm đến hấp dẫn và đặt chuyến đi ngay hôm nay!</p>
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">Đặt Tour Ngay</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>