@model DuLich.Models.InvoiceViewModel
@{
    Layout = null; // render gọn trong iframe/dialog
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/css/bootstrap.min.css" />
    <style>
        body { padding: 24px; font-family: "Segoe UI", Arial, sans-serif; background: #f8f9fa; }
        .card { border: none; }
        .text-muted { color: #6c757d !important; }
        @@media print {
            .not-print { display: none !important; }
            body { background: #fff; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h3 class="text-primary text-uppercase mb-2">Hóa đơn đặt tour</h3>
                <p class="text-muted mb-1">Mã hóa đơn: <strong>@Model.MaHoaDon</strong></p>
                <p class="text-muted mb-0">Ngày xuất: <strong>@Model.NgayXuat?.ToString("dd/MM/yyyy HH:mm:ss")</strong></p>
            </div>

            <hr />

            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted">Thông tin khách hàng</h6>
                    <p class="mb-1"><strong>@Model.TenKhachHang</strong></p>
                    <p class="mb-1">@Model.Email</p>
                    <p class="mb-1">@Model.SoDienThoai</p>
                    <p class="mb-0">@Model.DiaChi</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted">Trạng thái</h6>
                    <p class="mb-1"><strong>@Model.TrangThai</strong></p>
                    <p class="mb-1"><strong>Phương thức thanh toán:</strong> @(Model.PaymentMethod ?? "Chưa chọn")</p>
                    <p class="text-muted small mb-0">
                        @(Model.IsSignatureValid ? "Chữ ký số hợp lệ." : "Không xác minh được chữ ký số.")
                    </p>
                </div>
            </div>

            <hr />

            <div class="mb-4">
                <h6 class="text-uppercase text-muted">Chi tiết tour</h6>
                <p class="mb-1"><strong>Tên tour:</strong> @Model.TenTour</p>
                <p class="mb-1"><strong>Ngày khởi hành:</strong> @Model.NgayKhoiHanh?.ToString("dd/MM/yyyy")</p>
                <p class="mb-1"><strong>Người lớn:</strong> @Model.SoNguoiLon</p>
                <p class="mb-0"><strong>Trẻ em:</strong> @Model.SoTreEm</p>
            </div>

            <div class="text-right">
                <p class="mb-1 text-muted">Tổng cộng</p>
                <h4 class="text-primary">@Model.SoTien?.ToString("#,##0") VNĐ</h4>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4 justify-content-center not-print">
                <button class="btn btn-primary rounded-pill px-4" onclick="window.print()">
                    <i class="fa fa-print mr-1"></i> In hóa đơn
                </button>
                <a class="btn btn-outline-secondary rounded-pill px-4"
                   href="@Url.Action("DownloadInvoicePdf", "Customer", new { hoaDonId = Model.MaHoaDon })">
                    <i class="fa fa-file-pdf mr-1"></i> Tải PDF
                </a>
                <button class="btn btn-light rounded-pill px-4" onclick="closeDialog()">
                    Đóng
                </button>
            </div>
        </div>
    </div>

    <script>
        function closeDialog() {
            if (window.parent && window.parent.$) {
                window.parent.$('.modal').modal('hide');
            } else {
                window.close();
            }
        }
    </script>
</body>
</html>
