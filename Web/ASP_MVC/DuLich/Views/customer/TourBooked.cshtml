@model DuLich.Models.TourBookedViewModel

@{
    ViewData["Title"] = "Chi tiết tour đã đặt";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var item = Model.TourBooked;
}

@section Hero {
    <div class="container-fluid bg-primary py-5 mb-5 hero-header">
        <div class="container text-center py-5">
            <h1 class="display-5 text-white mb-3">@item.Title</h1>
            <p class="text-white-50 mb-0">Mã đơn đặt tour: #@Model.BookingId</p>
        </div>
    </div>
}

<div class="container-xxl py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Customer" asp-action="CancelBooking" method="post" class="row g-4 align-items-start" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đặt tour này không?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" value="@Model.BookingId" />
            
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h4 class="mb-0 text-primary"><i class="fa fa-user-circle me-2"></i>Thông tin liên hệ</h4>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Họ và tên</label>
                                <input type="text" class="form-control bg-light" value="@item.FullName" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Email</label>
                                <input type="email" class="form-control bg-light" value="@item.Email" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Số điện thoại</label>
                                <input type="text" class="form-control bg-light" value="@item.PhoneNumber" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Địa chỉ</label>
                                <input type="text" class="form-control bg-light" value="@item.Address" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-primary">Tóm tắt đơn</h5>
                        @if (item.BookingStatus == "c") { <span class="badge bg-danger rounded-pill">Đã hủy</span> }
                        else if (item.BookingStatus == "f") { <span class="badge bg-secondary rounded-pill">Hoàn thành</span> }
                        else if (item.BookingStatus == "y") { <span class="badge bg-success rounded-pill">Sắp khởi hành</span> }
                        else { <span class="badge bg-warning text-dark rounded-pill">Đang xử lý</span> }
                    </div>

                    <div class="card-body px-4 pb-4">
                        <p class="mb-4 d-flex align-items-center text-dark">
                            <i class="fa fa-calendar-alt text-primary me-2"></i>
                            <span class="fw-bold">@item.StartDate?.ToString("dd/MM/yyyy") - @item.EndDate?.ToString("dd/MM/yyyy")</span>
                        </p>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="fw-bold text-dark">Tổng cộng</span>
                                <span class="fw-bold text-primary fs-5">@item.TotalPrice.ToString("N0") VNĐ</span>
                            </li>
                        </ul>

                        <div class="mb-4">
                            <label class="small text-muted fw-bold mb-1">Trạng thái thanh toán:</label>
                            @if (item.IsPaid)
                            {
                                <div class="alert alert-success d-flex align-items-center mb-0 py-2">
                                    <i class="fa fa-check-circle me-2"></i>
                                    <div>
                                        <strong>Đã ghi nhận thanh toán</strong><br/>
                                        <small>(@ViewBag.PaymentStatusText)</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning d-flex align-items-center mb-0 py-2">
                                    <i class="fa fa-clock me-2"></i>
                                    <div><strong>Chưa thanh toán</strong></div>
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            @if (item.BookingStatus != "c" && item.BookingStatus != "f")
                            {
                                if (!item.IsPaid)
                                {
                                    <a asp-controller="Customer" asp-action="Payment" asp-route-bookingId="@Model.BookingId"
                                       class="btn btn-primary py-2 fw-bold"><i class="fa fa-credit-card me-2"></i>Thanh toán ngay</a>
                                    
                                    @if (!Model.HideCancelButton)
                                    {
                                        <button type="submit" class="btn btn-outline-danger py-2">Hủy đặt tour</button>
                                    }
                                }
                                else
                                {
                                    @if (item.IsIssued)
                                    {
                                        <a class="btn btn-success" target="_blank" asp-controller="Customer"
                                           asp-action="DownloadInvoicePdf" asp-route-hoaDonId="@item.CheckoutId">
                                            <i class="fa fa-download me-1"></i> Tải Hóa đơn PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info text-center small mb-0">
                                            <i class="fa fa-spinner fa-spin me-1"></i> Đang chờ nhân viên xuất hóa đơn.
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>