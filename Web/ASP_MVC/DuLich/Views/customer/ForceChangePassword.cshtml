@model DuLich.Models.ForceChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu định kỳ";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="text-center mb-4">
    <h4 class="mb-2">@ViewData["Title"]</h4>
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle mr-2"></i>
        Mật khẩu của bạn đã hết hạn sử dụng. Vui lòng đổi mật khẩu mới để tiếp tục.
    </div>
</div>

<form asp-action="ForceChangePassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>
    
    <div class="form-group mb-3">
        <label class="form-label fw-semibold">Tài khoản</label>
        <input asp-for="Username" class="form-control" readonly style="background-color: #e9ecef;" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="OldPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
        <input asp-for="OldPassword" class="form-control" placeholder="Nhập mật khẩu cũ để xác minh" />
        <span asp-validation-for="OldPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
        <input asp-for="NewPassword" class="form-control" placeholder="Nhập mật khẩu mới" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
        <small class="form-text text-muted">Tối thiểu 8 ký tự, gồm chữ hoa, số và ký tự đặc biệt.</small>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button type="submit" class="btn btn-primary btn-block">Đổi mật khẩu và Đăng nhập</button>
        <a asp-action="Login" class="btn btn-outline-secondary btn-block mt-2">Quay lại</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}