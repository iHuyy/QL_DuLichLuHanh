@using Microsoft.AspNetCore.Http.Extensions
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Nunito:wght@600;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="icon" type="image/x-icon" href="~/images/logo.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/travel-agency/lib/animate/animate.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/travel-agency/lib/owlcarousel/assets/owl.carousel.min.css"
        asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/travel-agency/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css"
        asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/travel-agency/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/travel-agency/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuLich.styles.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>

<body>
    <div id="spinner"
        class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <script>
        // Fallback: hide spinner after load even if main JS fails to run
        window.addEventListener('load', function () {
            const spinner = document.getElementById('spinner');
            if (spinner) {
                setTimeout(() => spinner.classList.remove('show'), 300);
            }
        });
    </script>

    <div class="container-fluid position-relative p-0">
        <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
            <a asp-controller="Customer" asp-action="Index" class="navbar-brand p-0">
                <img src="~/images/logo.png" asp-append-version="true" alt="DuLich" class="img-fluid logo-brand"
                    style="height: 48px;" loading="lazy" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a asp-controller="Customer" asp-action="Index"
                        class="nav-item nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : string.Empty)">Trang
                        chủ</a>
                    <a asp-controller="Customer" asp-action="About"
                        class="nav-item nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : string.Empty)">Giới
                        thiệu</a>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Customer" asp-action="MyTour"
                            class="nav-item nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyTour" ? "active" : string.Empty)">Tour
                            của tôi </a>
                    }
                </div>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown ms-lg-3">
                        <button class="btn btn-outline-primary rounded-pill dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile">Thông tin cá
                                    nhân</a></li>
                            <li><a class="dropdown-item" asp-controller="Customer" asp-action="MyTour">Tour đã đặt</a></li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>
                                <form asp-controller="Customer" asp-action="Logout" method="post" class="px-3">
                                    <button type="submit" class="btn btn-link p-0 text-danger">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column flex-lg-row gap-2 ms-lg-3">
                        <a asp-controller="Customer" asp-action="Login"
                            class="btn btn-outline-primary rounded-pill px-4">Đăng nhập</a>
                        <a asp-controller="Customer" asp-action="Register" class="btn btn-primary rounded-pill px-4">Đăng
                            ký</a>
                    </div>
                }
            </div>
        </nav>

        @if (IsSectionDefined("Hero"))
        {
            @RenderSection("Hero", required: false)
        }
    </div>

    @if (IsSectionDefined("FullWidth"))
    {
        @RenderSection("FullWidth", required: false)
    }
    else
    {
        <div class="container-xxl py-5">
            @RenderBody()
        </div>
    }

    <div class="container-fluid bg-dark text-light footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <h4 class="text-white mb-3">TravelHa</h4>
                    <p>Đồng hành cùng bạn trong mọi hành trình khám phá với các tour được thiết kế riêng cho gia đình,
                        bạn bè và doanh nghiệp.</p>
                    <div class="d-flex pt-2">
                        <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-youtube"></i></a>
                        <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

            </div>
        </div>
        <div class="container">
            <div class="copyright">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        &copy; @DateTime.Now.Year DuLich Travel. All Rights Reserved.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>

    <script src="~/customer/travel-agency/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="~/customer/travel-agency/lib/wow/wow.min.js" asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/easing/easing.min.js" asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/waypoints/waypoints.min.js" asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/owlcarousel/owl.carousel.min.js" asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/tempusdominus/js/moment.min.js" asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/tempusdominus/js/moment-timezone.min.js"
        asp-append-version="true"></script>
    <script src="~/customer/travel-agency/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"
        asp-append-version="true"></script>
    <script src="~/customer/travel-agency/js/main.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Session Timeout Modal -->
        <div class="modal fade" id="sessionTimeoutModal" tabindex="-1" aria-labelledby="sessionTimeoutModalLabel"
            aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="sessionTimeoutModalLabel">Phiên sắp hết hạn</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Phiên làm việc của bạn sẽ hết hạn sau <span id="sessionTimeoutCountdown">60</span> giây. Bạn có muốn
                        tiếp tục?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" id="logoutButton">Đăng xuất</button>
                        <button type="button" class="btn btn-primary" id="keepAliveButton">Tiếp tục</button>
                    </div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            (function () {
                const sessionMinutes = 15;
                const warningSecondsBeforeEnd = 60;

                let warningTimer;
                let logoutTimer;
                let countdownInterval;

                const modalElement = document.getElementById('sessionTimeoutModal');
                const modalInstance = new bootstrap.Modal(modalElement);
                const countdownElement = document.getElementById('sessionTimeoutCountdown');

                function startTimers() {
                    clearTimeout(warningTimer);
                    clearTimeout(logoutTimer);
                    clearInterval(countdownInterval);

                    const warningTime = (sessionMinutes * 60 - warningSecondsBeforeEnd) * 1000;
                    const logoutTime = sessionMinutes * 60 * 1000;

                    warningTimer = setTimeout(showWarning, warningTime);
                    logoutTimer = setTimeout(logout, logoutTime);
                }

                function showWarning() {
                    modalInstance.show();
                    let secondsLeft = warningSecondsBeforeEnd;
                    countdownElement.textContent = secondsLeft;

                    countdownInterval = setInterval(() => {
                        secondsLeft--;
                        countdownElement.textContent = secondsLeft;
                        if (secondsLeft <= 0) {
                            clearInterval(countdownInterval);
                        }
                    }, 1000);
                }

                async function keepAlive() {
                    try {
                        const response = await fetch('/api/ApiAuth/keepalive', {
                            method: 'GET',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        if (response.ok) {
                            console.log("Session extended.");
                            modalInstance.hide();
                            startTimers(); // Restart timers after successful keep-alive
                        } else {
                            logout(); // If keep-alive fails, logout
                        }
                    } catch (error) {
                        logout(); // If there's a network error, logout
                    }
                }

                function logout() {
                    // Use the form post to ensure middleware for logout runs properly
                    const logoutForm = document.createElement('form');
                    logoutForm.method = 'post';
                    logoutForm.action = '/Customer/Logout';
                    // Add antiforgery token if your form has one
                    document.body.appendChild(logoutForm);
                    logoutForm.submit();
                }

                // Event Listeners
                document.getElementById('keepAliveButton').addEventListener('click', keepAlive);
                document.getElementById('logoutButton').addEventListener('click', logout);

                // Reset timers on user activity
                ['mousemove', 'mousedown', 'keypress', 'scroll', 'touchstart'].forEach(event => {
                    document.addEventListener(event, startTimers, { passive: true });
                });

                // Initial start
                startTimers();
            })();
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>

</html>