@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>Quản lý khách hàng (theo chi nhánh của bạn)</h4>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <span class="text-muted mt-2">Chỉ hiển thị khách đã đặt tour thuộc chi nhánh của bạn.</span>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="customersList" class="display" style="min-width: 1000px">
                        <thead>
                            <tr>
                                <th>Ma KH</th>
                                <th>Họ tên</th>
                                <th>Số điện thoại</th>
                                <th>Email</th>
                                <th>Số tour đã đặt</th>
                                <th>Tour gần nhất</th>
                                <th>Ngày đặt gần nhất</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadCustomers();
        });

        function loadCustomers() {
            $('#customersList').DataTable({
                ajax: '/staff/api/customers/bookings',
                order: [[6, 'desc']],
                columns: [
                    { data: 'maKhachHang' },
                    { data: 'hoTen' },
                    { data: 'soDienThoai' },
                    { data: 'email' },
                    { data: 'soTourDaDat' },
                    { data: 'lastTour' },
                    {
                        data: 'lastBookingDate',
                        render: function (data) {
                            return data ? moment(data).format('DD/MM/YYYY') : '';
                        }
                    }
                ]
            });
        }
    </script>
}
