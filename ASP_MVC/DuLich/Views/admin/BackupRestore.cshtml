@model DuLich.Models.BackupRestoreViewModel
@{
    ViewData["Title"] = "Sao lưu & Phục hồi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <div>
                <h4 class="page-title mb-1">Sao lưu &amp; Phục hồi</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item active">Sao lưu &amp; Phục hồi</li>
                </ol>
            </div>
            <span class="badge badge-primary">RMAN</span>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Cấu hình RMAN</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">Cấu hình đặt trên máy DB (Linux). Admin nắm chính sách.</p>
                <pre class="bg-light p-3 border rounded small mb-0">@Model.RetentionPolicy
@Model.ControlfileAutobackup
@Model.ChannelFormat
@Model.ArchivelogDeletionPolicy</pre>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Thao tác</h5>
                    <small class="text-muted">Gửi yêu cầu chạy RMAN trên máy chủ CSDL qua SSH.</small>
                </div>
            </div>
            <div class="card-body">
                <h6 class="mb-3">Sao lưu</h6>
                <form asp-action="RunBackup" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <button type="submit" name="type" value="FULL" class="btn btn-primary btn-block">
                                <i class="fa fa-database mr-2"></i> Sao lưu toàn bộ (Full)
                            </button>
                        </div>
                        <div class="col-md-6 mb-3">
                            <button type="submit" name="type" value="INCREMENTAL" class="btn btn-outline-primary btn-block">
                                <i class="fa fa-sync-alt mr-2"></i> Sao lưu thay đổi (Incremental)
                            </button>
                        </div>
                    </div>
                </form>
                <div class="border-top pt-3">
                    <h6 class="mb-3">Phục hồi</h6>
                    <form asp-action="RestoreBackup" asp-controller="Admin" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-8">
                                <label for="backupPath">Chọn bản sao lưu để phục hồi</label>
                                <select id="backupPath" name="backupPath" class="form-control" asp-items="Model.BackupFiles" required>
                                    <option value="" disabled selected>-- Chọn một bản sao lưu cụ thể --</option>
                                </select>
                                <small class="form-text text-muted">Ứng dụng sẽ phục hồi đến thời điểm kết thúc bản backup (point-in-time an toàn).</small>
                            </div>
                            <div class="form-group col-md-4">
                                <button type="submit" class="btn btn-danger btn-block">
                                    <i class="fa fa-undo mr-2"></i> Phục hồi
                                </button>
                            </div>
                        </div>
                    </form>
                    <p class="text-muted small mb-0">Thao tác sẽ thực thi RMAN RESTORE/RECOVER trên máy chủ CSDL.</p>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Lịch sử sao lưu</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-sm">
                        <thead class="thead-dark">
                            <tr>
                                <th>Loại</th>
                                <th>Bắt đầu</th>
                                <th>Kết thúc</th>
                                <th>Trạng thái</th>
                                <th style="width: 30%;">Đường dẫn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.History == null || !Model.History.Any())
                            {
                                <tr><td colspan="5" class="text-center">Chưa có bản sao lưu nào.</td></tr>
                            }
                            else
                            {
                                foreach (var item in Model.History)
                                {
                                    <tr>
                                        <td>@item.Type</td>
                                        <td>@item.StartedAt.ToString("dd/MM/yy HH:mm")</td>
                                        <td>@(item.FinishedAt.HasValue ? item.FinishedAt.Value.ToString("dd/MM/yy HH:mm") : "-")</td>
                                        <td>
                                            @{
                                                var statusLower = (item.Status ?? string.Empty).ToLower();
                                                var badgeClass = statusLower.Contains("hoàn tất") || statusLower.Contains("hoan tat")
                                                    ? "badge-success"
                                                    : statusLower.Contains("chạy") || statusLower.Contains("chay")
                                                        ? "badge-info"
                                                        : statusLower.Contains("thất bại") || statusLower.Contains("that bai")
                                                            ? "badge-danger"
                                                            : "badge-secondary";
                                            }
                                            <span class="badge @badgeClass">@item.Status</span>
                                        </td>
                                        <td class="text-monospace small" style="word-break: break-all;">@item.Location</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Lịch sử phục hồi</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-sm">
                        <thead class="thead-dark">
                            <tr>
                                <th>Loại</th>
                                <th>Bắt đầu</th>
                                <th>Kết thúc</th>
                                <th>Trạng thái</th>
                                <th style="width: 30%;">Phục hồi từ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RestoreHistory == null || !Model.RestoreHistory.Any())
                            {
                                <tr><td colspan="5" class="text-center">Chưa có lịch sử phục hồi nào.</td></tr>
                            }
                            else
                            {
                                foreach (var item in Model.RestoreHistory)
                                {
                                    <tr>
                                        <td>@item.Type</td>
                                        <td>@item.StartedAt.ToString("dd/MM/yy HH:mm")</td>
                                        <td>@(item.FinishedAt.HasValue ? item.FinishedAt.Value.ToString("dd/MM/yy HH:mm") : "-")</td>
                                        <td>
                                            @{
                                                var statusLower = (item.Status ?? string.Empty).ToLower();
                                                var badgeClass = statusLower.Contains("hoàn tất") || statusLower.Contains("hoan tat")
                                                    ? "badge-success"
                                                    : statusLower.Contains("chạy") || statusLower.Contains("chay")
                                                        ? "badge-info"
                                                        : statusLower.Contains("thất bại") || statusLower.Contains("that bai")
                                                            ? "badge-danger"
                                                            : "badge-secondary";
                                            }
                                            <span class="badge @badgeClass">@item.Status</span>
                                        </td>
                                        <td class="text-monospace small" style="word-break: break-all;">@item.Location</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
