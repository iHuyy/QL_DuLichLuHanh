@model DuLich.Services.OracleAuthService.UserDetail
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Chi tiết người dùng: @Model.Username</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8">@Model.Username</dd>
                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@Model.Created</dd>
                    <dt class="col-sm-4">Default Tablespace</dt>
                    <dd class="col-sm-8">@Model.DefaultTablespace</dd>
                    <dt class="col-sm-4">Quyền hiện tại</dt>
                    <dd class="col-sm-8">@string.Join(", ", Model.Roles)</dd>
                </dl>

                <h5 class="mt-4">Cấp quyền</h5>
                <form method="post" action="/Admin/GrantRole" class="d-flex gap-2">
                    <input type="hidden" name="username" value="@Model.Username" />
                    <select name="role" class="form-control">
                        <option value="ROLE_CUSTOMER">ROLE_CUSTOMER</option>
                        <option value="ROLE_ADMIN">ROLE_ADMIN</option>
                        <option value="ROLE_READ_ONLY">ROLE_READ_ONLY</option>
                    </select>
                    <button class="btn btn-primary" type="submit">Cấp quyền</button>
                </form>
            </div>
        </div>
    </div>
</div>
