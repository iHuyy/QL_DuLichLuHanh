@model DuLich.Models.AdminAuditViewModel
@using System.Text.Json
@using System.Text
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Nhat ky Audit He thong";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    IHtmlContent FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "{}")
        {
            return new HtmlString("<i class='text-muted'>(khong co)</i>");
        }

        try
        {
            using var doc = JsonDocument.Parse(json);
            var sb = new StringBuilder("<ul class='list-unstyled mb-0'>");
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                sb.Append($"<li><strong class='text-primary'>{prop.Name}:</strong> {prop.Value.ToString()}</li>");
            }
            sb.Append("</ul>");
            return new HtmlString(sb.ToString());
        }
        catch (JsonException)
        {
            return new HtmlString(System.Net.WebUtility.HtmlEncode(json));
        }
    }
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-title-box">
                <div class="row">
                    <div class="col">
                        <h4 class="page-title">Nhat ky Audit he thong</h4>
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Admin</a></li>
                            <li class="breadcrumb-item active">Nhat ky Audit</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="audit-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "TOUR" ? "active" : "")" id="tour-tab" data-toggle="tab" href="#tour" role="tab" aria-controls="tour" aria-selected="@(Model.ActiveTab == "TOUR")">Tour</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "STAFF" ? "active" : "")" id="staff-tab" data-toggle="tab" href="#staff" role="tab" aria-controls="staff" aria-selected="@(Model.ActiveTab == "STAFF")">Nhan vien</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "DATABASE" ? "active" : "")" id="database-tab" data-toggle="tab" href="#database" role="tab" aria-controls="database" aria-selected="@(Model.ActiveTab == "DATABASE")">CSDL</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="audit-tabs-content">
                <div class="tab-pane fade @(Model.ActiveTab == "TOUR" ? "show active" : "")" id="tour" role="tabpanel" aria-labelledby="tour-tab">
                    <h5 class="card-title">Audit Tour (trigger)</h5>
                    <p class="card-text">Quan ly audit trigger cho Tour va cac bang lien quan (HoaDon, DatTour, ChiTietTour).</p>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Thoi gian</th>
                                    <th>Bang</th>
                                    <th>Hanh dong</th>
                                    <th>Gia tri cu</th>
                                    <th>Gia tri moi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TourRecords == null || !Model.TourRecords.Any())
                                {
                                    <tr><td colspan="5" class="text-center">Khong tim thay du lieu audit.</td></tr>
                                }
                                else
                                {
                                    @foreach (var record in Model.TourRecords)
                                    {
                                        <tr>
                                            <td>@record.Timestamp?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>@record.TableName</td>
                                            <td><span class="badge badge-info">@record.Action</span></td>
                                            <td><div style="max-height: 150px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.85em; white-space: pre-wrap; word-break: break-all;">@FormatJson(record.OldValue)</div></td>
                                            <td><div style="max-height: 150px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.85em; white-space: pre-wrap; word-break: break-all;">@FormatJson(record.NewValue)</div></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @{
                        var tourTotalPages = (int)Math.Ceiling((double)(Model.TourTotal) / Model.PageSize);
                    }
                    @if (tourTotalPages > 1)
                    {
                        <nav aria-label="Tour pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.TourPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="TOUR" asp-route-pageTour="@(Model.TourPage - 1)" aria-label="Previous">&laquo;</a>
                                </li>
                                @for (int i = 1; i <= tourTotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.TourPage ? "active" : "")">
                                        <a class="page-link" asp-action="Audit" asp-route-tab="TOUR" asp-route-pageTour="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.TourPage >= tourTotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="TOUR" asp-route-pageTour="@(Model.TourPage + 1)" aria-label="Next">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

                <div class="tab-pane fade @(Model.ActiveTab == "STAFF" ? "show active" : "")" id="staff" role="tabpanel" aria-labelledby="staff-tab">
                    <h5 class="card-title">Audit Nhân viên (Standard)</h5>
                    <p class="card-text">Quản lý audit standard cho bảng NhânViên.</p>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Hành động</th>
                                    <th>Thời gian</th>
                                    <th>SQL thực thi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.StaffRecords == null || !Model.StaffRecords.Any())
                                {
                                    <tr><td colspan="3" class="text-center">Không tìm thấy dữ liệu audit.</td></tr>
                                }
                                else
                                {
                                    @foreach (var record in Model.StaffRecords)
                                    {
                                        <tr>
                                            <td><span class="badge badge-primary">@record.Action</span></td>
                                            <td>@record.Timestamp?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><div style="max-height: 100px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.8em; white-space: pre-wrap; word-break: break-all;">@record.SqlText</div></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @{
                        var staffTotalPages = (int)Math.Ceiling((double)(Model.StaffTotal) / Model.PageSize);
                    }
                    @if (staffTotalPages > 1)
                    {
                        <nav aria-label="Staff pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.StaffPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="STAFF" asp-route-pageStaff="@(Model.StaffPage - 1)" aria-label="Previous">&laquo;</a>
                                </li>
                                @for (int i = 1; i <= staffTotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.StaffPage ? "active" : "")">
                                        <a class="page-link" asp-action="Audit" asp-route-tab="STAFF" asp-route-pageStaff="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.StaffPage >= staffTotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="STAFF" asp-route-pageStaff="@(Model.StaffPage + 1)" aria-label="Next">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

                <div class="tab-pane fade @(Model.ActiveTab == "DATABASE" ? "show active" : "")" id="database" role="tabpanel" aria-labelledby="database-tab">
                    <h5 class="card-title">Audit CSDL (toan bo schema)</h5>
                    <p class="card-text">Tat ca ban ghi audit tren schema TADMIN (bao gom standard va FGA neu co).</p>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Thoi gian</th>
                                    <th>Nguoi thuc hien</th>
                                    <th>Bang</th>
                                    <th>Policy</th>
                                    <th>Hanh dong</th>
                                    <th>SQL thuc thi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DatabaseRecords == null || !Model.DatabaseRecords.Any())
                                {
                                    <tr><td colspan="6" class="text-center">Khong tim thay du lieu audit.</td></tr>
                                }
                                else
                                {
                                    @foreach (var record in Model.DatabaseRecords)
                                    {
                                        <tr>
                                            <td>@record.Timestamp?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>@record.PerformedBy</td>
                                            <td>@record.TableName</td>
                                            <td>@(string.IsNullOrWhiteSpace(record.PolicyName) ? "-" : record.PolicyName)</td>
                                            <td><span class="badge badge-success">@record.Action</span></td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(record.SqlText))
                                                {
                                                    <div style="max-height: 100px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.8em; white-space: pre-wrap; word-break: break-all;">@record.SqlText</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @{
                        var dbTotalPages = (int)Math.Ceiling((double)(Model.DatabaseTotal) / Model.PageSize);
                    }
                    @if (dbTotalPages > 1)
                    {
                        <nav aria-label="Database pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.DatabasePage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="DATABASE" asp-route-pageDatabase="@(Model.DatabasePage - 1)" aria-label="Previous">&laquo;</a>
                                </li>
                                @for (int i = 1; i <= dbTotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.DatabasePage ? "active" : "")">
                                        <a class="page-link" asp-action="Audit" asp-route-tab="DATABASE" asp-route-pageDatabase="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.DatabasePage >= dbTotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Audit" asp-route-tab="DATABASE" asp-route-pageDatabase="@(Model.DatabasePage + 1)" aria-label="Next">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var hash = window.location.hash;
            if (hash) {
                $('#audit-tabs a[href="' + hash + '"]').tab('show');
            }

            $('#audit-tabs a').on('shown.bs.tab', function (e) {
                window.location.hash = e.target.hash;
            });
        });
    </script>
}
